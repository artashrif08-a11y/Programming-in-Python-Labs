students = [
    [201, "Amina", [78, 85, 90]],
    [202, "Rahim", [65, 70, 68]],
    [203, "Nadia", [92, 88, 95]],
    [204, "Hasan", [55, 60, 65]],
    [205, "Tania", [80, 80, 80]]
]


def calculate_average(marks):
    total = sum(marks)
    average = total / len(marks)
    return average


def display_students(students):
    for student in students:
        average = calculate_average(student[2])

        print("ID:", student[0])
        print("Name:", student[1])
        print("Marks:", student[2])
        print("Average:", round(average, 2))
        print()


def find_top_student(students):
    top_student = students[0]

    for student in students:
        if calculate_average(student[2]) > calculate_average(top_student[2]):
            top_student = student

    print("Top Student:", top_student[1])
    print("Average:", round(calculate_average(top_student[2]), 2))


def calculate_class_average(students):
    total = 0

    for student in students:
        total = total + calculate_average(student[2])

    class_average = total / len(students)

    print("Class Average:", round(class_average, 2))


display_students(students)

find_top_student(students)

calculate_class_average(students)
